# URL de la API. En el emulador Android usá http://10.0.2.2:8000; en un celular físico, la IP de tu PC.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Client IDs de Google OAuth (Google Cloud Console → Credenciales). Sin ellos el botón de Google se oculta.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
